# Copiez ce fichier en `.env` et remplissez les valeurs.

# === Admin ===
ADMIN_USERNAME=admin
ADMIN_PASSWORD=lumina2026!

# === Base de données (SQLite) ===
# Local : file:./dev.db
# Render : file:/var/data/dev.db
DATABASE_URL=file:./dev.db

# === Stripe (laisser vide pour désactiver le paiement en ligne) ===
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# === URL publique du site (utilisée pour Stripe + SEO) ===
NEXT_PUBLIC_APP_URL=http://localhost:3000
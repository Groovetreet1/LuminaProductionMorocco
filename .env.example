# Copiez ce fichier en `.env` et remplissez les valeurs.

# === Admin ===
ADMIN_USERNAME=admin
ADMIN_PASSWORD=lumina2026!

# === Base de données (PostgreSQL) ===
# Local (PostgreSQL installé sur votre machine) :
#   DATABASE_URL=postgresql://postgres:postgres@localhost:5432/lumina
# Render (après le Blueprint, l'URL interne est injectée automatiquement).
# Si vous utilisez l'URL externe de Render depuis votre machine, ajoutez :
#   DATABASE_SSL=true
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/lumina

# === Stripe (laisser vide pour désactiver le paiement en ligne) ===
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# === URL publique du site (utilisée pour Stripe + SEO) ===
NEXT_PUBLIC_APP_URL=http://localhost:3000